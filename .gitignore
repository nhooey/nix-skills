# `nix build` symlinks (root flake + per-skill sub-flakes)
/result
/result-*
/skills/*/result
/skills/*/result-*

# Project-scope skill installs from `nix develop`'s startup hooks; the
# skills' preferences files beside them are the project's own.
/.agents/skills/*
!/.agents/skills/*.preferences.md
/.claude/skills/

# Per-branch git worktrees (see `using-git-worktrees` skill).
/.worktrees/
